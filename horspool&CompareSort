import java.util.Arrays;
import java.util.Scanner;

public class Horspool {

    private static int[] preprocess(String pattern) {
        int m = pattern.length();
        int[] shiftTable = new int[256];
        Arrays.fill(shiftTable, m);
        for (int j = 0; j < m - 1; j++) {
            shiftTable[pattern.charAt(j)] = m - 1 - j;
        }
        return shiftTable;
    }

    public static void searchWithStats(String text, String pattern) {
        int n = text.length();
        int m = pattern.length();
        int alignments = 0;
        int comparisons = 0;
        int index = -1;

        if (m <= n && m > 0) {
            int[] shiftTable = preprocess(pattern);
            int i = m - 1;

            while (i < n) {
                alignments++;
                int k = 0;

                while (k < m) {
                    comparisons++;
                    if (pattern.charAt(m - 1 - k) == text.charAt(i - k)) {
                        k++;
                    } else {
                        break;
                    }
                }

                if (k == m) {
                    index = i - m + 1;
                    break;
                }

                i += shiftTable[text.charAt(i)];
            }
        }
        if (index != -1) {
            System.out.println("Pattern found at index: " + index);
        } else {
            System.out.println("Pattern not found.");
        }
        System.out.println("Total Alignments: " + alignments);
        System.out.println("Total Comparisons: " + comparisons);
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter text: ");
        String text = scanner.nextLine();

        System.out.print("Enter pattern: ");
        String pattern = scanner.nextLine();

        searchWithStats(text, pattern);

        scanner.close();
    }
}

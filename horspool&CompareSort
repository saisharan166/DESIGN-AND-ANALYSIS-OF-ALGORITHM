import java.util.*;
class CompareSortPgm {
   public int[] countSort(int[] arr,int size){
      int n=size;
      int[] count=new int[n];
      int[] s=new int[n];
      for(int i=0;i<n;i++){
         count[i]=0;
         s[i]=0;
      }
      for(int i=0;i<n-1;i++){
         for(int j=i+1;j<n;j++){
            if(arr[i]>arr[j]){
               count[i]=count[i]+1;
            }
            else{
               count[j]=count[j]+1;
            }
         }
         for(int a:count){
            System.out.print(a+" ");
         }
         System.out.println();
      }
      for(int i=0;i<n;i++){
         s[count[i]]=arr[i];
      }
      return s;
   }
   public static void main(String[] args){
      Scanner sc=new Scanner(System.in);
      CompareSortPgm cs=new CompareSortPgm();
      System.out.println("Enter the no. of Elements:");
      int size=sc.nextInt();
      int[] arr=new int[size];
      for(int i=0;i<size;i++){
         System.out.print("Enter the Element "+(i+1)+":");
         arr[i]=sc.nextInt();
      }
      int[] res=cs.countSort(arr,size);
      for(int a:res){
         System.out.print(a+" ");
      }
   }
}


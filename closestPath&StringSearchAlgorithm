#include <iostream>
#include <string>
void searchAndStop(const std::string& text, const std::string& pattern) {
    int n = text.length();
    int m = pattern.length();
    int totalAlignments = 0;
    int totalComparisons = 0;
    for (int i = 0; i <= n - m; i++) {
        totalAlignments++;
        std::cout << "Alignment :" << totalAlignments << " (Index " << i << "):\n";
        std::cout << "Text:    " << text << "\n";
        std::string padding(i, ' ');
        std::cout << "Pattern: " << padding << pattern << "\n";
        std::cout << "Match:   " << padding;
        int j;
        for (j = 0; j < m; j++) {
            totalComparisons++;
            if (text[i + j] == pattern[j]) {
                std::cout << "+";
            } else {
                std::cout << "x";
                break;
            }
        }
        std::cout << "\n\n";
        if (j == m) {
            std::cout << "Match Found!\n";
            std::cout << "Final Index: " << i << "\n";
            goto statistics;
        }
    }
    std::cout << "Pattern not found.\n";

statistics:
    std::cout << "_________________________\n";
    std::cout << "No. of Alignments:  " << totalAlignments << "\n";
    std::cout << "No. of Comparisons: " << totalComparisons << "\n";
    std::cout << "_________________________\n";
}

int main() {
    std::string text, pattern;
    std::cout << "Enter Text: ";
    std::getline(std::cin, text);
    std::cout << "Enter Pattern: ";
    std::getline(std::cin, pattern);

    if (!text.empty() && !pattern.empty() && pattern.length() <= text.length()) {
        searchAndStop(text, pattern);
    } else {
        std::cout << "Invalid input lengths.\n";
    }

    return 0;
}

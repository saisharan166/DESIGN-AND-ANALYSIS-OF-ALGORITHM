#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

struct Point {
    double x, y;
};

int main() {
    int n;
    cout << "Enter number of points: ";
    cin >> n;

    Point p[100];
    for (int i = 0; i < n; i++) {
        cout << "Point " << i + 1 << " (x y): ";
        cin >> p[i].x >> p[i].y;
    }

    double min_dist = 9999999.0;
    int first = 0, second = 0;
    int comparisons = 0;

    cout << "\n--Distances--" << endl;

    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            comparisons++;


            double d = sqrt(pow(p[j].x - p[i].x, 2) + pow(p[j].y - p[i].y, 2));


            cout << "Distance between Point " << i + 1 << " and Point " << j + 1 << "    = " << d << endl;


            if (d < min_dist) {
                min_dist = d;
                first = i;
                second = j;
            }
        }
    }


    cout << "\n-----------------------------" << endl;
    if (n < 2) {
        cout << "Not enough points to find a pair." << endl;
    } else {
        cout << "MINIMUM DISTANCE FOUND" << endl;
        cout << "Closest: Point " << first + 1 << " and " << second + 1 << endl;
        cout << "Distance: " << min_dist << endl;
        cout << "Total Comparisons: " << comparisons << endl;
    }

    return 0;
}

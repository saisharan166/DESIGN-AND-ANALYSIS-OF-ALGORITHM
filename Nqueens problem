import java.util.Scanner;
public class Queen {
    static int solutionCount = 0;

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter N Value: ");
        int n = sc.nextInt();
        int[][] board = new int[n][n];
        solveNQueens(board, 0, n);

        if (solutionCount == 0) {
            System.out.println("No solution exists for N = " + n);
        }
        sc.close();
    }
    static void solveNQueens(int[][] board, int col, int n) {

        if (col == n) {
            solutionCount++;
            displaySolution(board, n);
            return;
        }

        for (int i = 0; i < n; i++) {
            if (isSafe(board, i, col, n)) {
                board[i][col] = 1;
                solveNQueens(board, col + 1, n);
                board[i][col] = 0;
            }
        }
    }
    static boolean isSafe(int[][] board, int row, int col, int n) {

        for (int i = 0; i < col; i++)
            if (board[row][i] == 1) return false;


        for (int i = row, j = col; i >= 0 && j >= 0; i--, j--)
            if (board[i][j] == 1) return false;


        for (int i = row, j = col; j >= 0 && i < n; i++, j--)
            if (board[i][j] == 1) return false;

        return true;
    }

    static void displaySolution(int[][] board, int n) {
        System.out.println(" Solution " + solutionCount + "");
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                System.out.print(board[i][j] == 1 ? "Q " : "- ");
           }
            System.out.println();
        }
        System.out.print("Queen Indices: ");
        for (int j = 0; j < n; j++) {
            for (int i = 0; i < n; i++) {
                if (board[i][j] == 1) System.out.print("(" + i + "," + j + ") ");
            }
        }
        System.out.println("\n");
    }
}
